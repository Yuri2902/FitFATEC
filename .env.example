# Copie para .env, depois preencha apenas as suas credenciais (nunca versionar .env).
# O servidor carrega automaticamente este arquivo na raiz quando python-dotenv está instalado.
DB_HOST=localhost
DB_NAME=fitfatec
DB_USER=root
DB_PASSWORD=COLOQUE_SUA_SENHA_AQUI
# Gere uma chave aleatória com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=COLOQUE_CHAVE_ALEATORIA_AQUI
# Opcional: sem chave, a Kiara usa o catálogo offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
FLASK_DEBUG=0
